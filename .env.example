# Copy to .env and fill in. Never commit .env. Create a programmatic access
# token in Snowsight under your user menu -> Account -> Programmatic access
# tokens. Scope it to the role you set below (ACCOUNTADMIN is fine for a demo
# account; a dedicated ANALYST role is better for anything real).

SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=mayankgoel
SNOWFLAKE_TOKEN=paste-your-PAT-here
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=HINDSIGHT
SNOWFLAKE_SCHEMA=ANALYTICS
