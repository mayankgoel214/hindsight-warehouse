# Copy to .env and fill in. Never commit .env. Auth is key-pair: generate a key
# with openssl, register the public half with ALTER USER ... SET RSA_PUBLIC_KEY,
# and point SNOWFLAKE_PRIVATE_KEY_PATH at the private half (kept outside the repo).

SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=mayankgoel
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/you/.snowflake/hindsight_key.p8
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=HINDSIGHT
SNOWFLAKE_SCHEMA=ANALYTICS
